# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend (Render / local) — SUPABASE_URL required on Render for JWKS (ES256); legacy HS256 optional:
# SUPABASE_JWT_SECRET=your-jwt-secret

# Local dev without Supabase: accept "dev-token" + unsigned JWTs. NEVER set this on Render.
# Ignored whenever SUPABASE_URL is set.
DEV_AUTH_ENABLED=false
DATABASE_URL=postgresql://postgres:password@localhost:5432/pozz
# Redis not required for MVP (Postgres jobs). Optional later:
# REDIS_URL=redis://localhost:6379
SPEND_CAP_TZ=Europe/Warsaw
ALLOWED_ADMIN_EMAILS=fifmazurkiewicz@gmail.com

# Text / STT (docs/architecture-for-cursor.md §4)
TEXT_PROVIDER=openrouter
TEXT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=your-openrouter-key

# Voice — lamp ON uses Live when VOICE_MODE=speech_to_speech
VOICE_MODE=speech_to_speech
GOOGLE_API_KEY=your-google-api-key
STT_PROVIDER=groq
GROQ_API_KEY=your-groq-key
# OPENAI_API_KEY=your-openai-key
TTS_PROVIDER=elevenlabs
TTS_VOICE_ID=
ELEVENLABS_API_KEY=your-elevenlabs-key

# Langfuse Cloud — runtime prompt SoT + tracing
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# promptfoo — local/CI fixtures in repo
# PROMPTFOO_API_KEY=your-promptfoo-key

# Public URLs (prod) — frontend vars live in frontend/.env.example / Vercel dashboard
# NEXT_PUBLIC_API_URL=https://api-pozz.fmazurkiewicz.dev

# --- Legacy Streamlit only (do not set on Render/Vercel) ---
# ENVIRONMENT=local
# AWS_REGION=eu-central-1
# OPENROUTER_SECRET_NAME=POZZ
# POSTGRES_SECRET_NAME=POZZ
